# defconfig =m options, decided one by one after CONFIG_MODULES was enabled (2026-10-23).
# Kept options stay =y per the trim policy (this SoC, USB peripherals, networking,
# software crypto); options for other SoCs/boards are switched off rather than built
# as modules. Helper symbols without a prompt are not listed: selects pull them in.
# Merge after gtaxllte-stage1.config.

# This SoC (Exynos 7870: DSI, Mali-T830 via Panfrost, USB DRD PHY)
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_SAMSUNG_DSIM=y
CONFIG_DRM_PANFROST=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_PHY_EXYNOS5_USBDRD=y

# USB peripherals via OTG: serial/modem, network adapters, HID
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_USBNET=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_MCS7830=y
CONFIG_USB_NET_NET1080=y
CONFIG_USB_NET_PLUSB=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_SR9800=y
CONFIG_USB_NET_ZAURUS=y
CONFIG_USB_PEGASUS=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
CONFIG_HID_MULTITOUCH=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_PHYLIB=y

# Networking stack
CONFIG_VLAN_8021Q=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_VETH=y
CONFIG_HSR=y
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_BLK_DEV_NBD=y
CONFIG_WWAN=y

# Crypto: software algorithms
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64_BS=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SM3=y
CONFIG_CRYPTO_SM4_GENERIC=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API_RNG=y

# Generic: dma-buf heaps, device mapper, userspace SPI, GPIO I2C/reset
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_BLK_DEV_DM=y
CONFIG_SPI_SPIDEV=y
CONFIG_I2C_GPIO=y
CONFIG_RESET_GPIO=y

# Core options that only dropped drivers used to select: tmpfs (/tmp), CMA for DRM and
# dma-buf, perf with the Cortex-A53 PMU
CONFIG_TMPFS=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_PERF_EVENTS=y
CONFIG_ARM_PMU=y
CONFIG_ARM_PMUV3=y
# Thermal: Exynos TMU for the SoC temperature (thermal chunk 1, 2026-10-24)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_EXYNOS_THERMAL=y
# CPU frequency scaling: cpufreq-dt on the CMU_CPUCL0/1 cluster clocks (thermal chunk 3c);
# userspace as the default until frequency switching is verified on HW, then schedutil
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
# CONFIG_CPU_FREQ_GOV_CONSERVATIVE is not set
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_THERMAL=y
# Menus that defconfig never sets itself, only dropped drivers selected them (chunk 3):
# regulators (S2MPS11, fixed/gpio/pwm), reset controller (simple-reset is bound),
# crypto core with the Cortex-A53 CE implementations
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SIMPLE=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_CE_CCM=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y

# Other SoCs/boards, debug/trace, VM-only: off (trim chunk 2, 2026-10-24)
