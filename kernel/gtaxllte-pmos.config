# postmarketOS requirements (pmaports kconfigcheck.toml, 2026-10-25): category
# "default" (incl. what systemd needs: BPF LSM, PSI, securityfs, BTF) and "zram"
# (2 GB RAM). Merge after gtaxllte-builtin.config.

# category:default
CONFIG_DM_CRYPT=y
CONFIG_NLS_ASCII=y
CONFIG_SYN_COOKIES=y
CONFIG_UEVENT_HELPER=y
CONFIG_NULL_TTY=m
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_PSI=y
CONFIG_UDMABUF=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
# BPF and debug info were trimmed for size in gtaxllte-stage1.config; pmOS
# (systemd) needs them back. Debug info only grows vmlinux and the modules, not
# the Image; build-stage1.sh strips the modules.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# category:zram
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_842=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_ZSTD=y

# Booted as an EFI application by U-Boot (systemd-boot on the FAT32 boot
# partition), no longer by S-Boot: EFI back, trimmed in gtaxllte-stage1.config.
# simpledrm keeps the framebuffer, so FB_EFI stays off.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
# Boot logs live in ramoops; keep efi-pstore from claiming pstore.
# CONFIG_EFI_VARS_PSTORE is not set

# WiFi: QCA9377 on SDIO (mmc1), ath10k_sdio. Other WLAN vendors stay off.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=m
CONFIG_ATH10K_SDIO=m
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_MORSEMICRO is not set
# CONFIG_WLAN_VENDOR_NXP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH12K is not set
# CONFIG_WCN36XX is not set

# DSI panel (Himax HX8279-D, backlight via DSI command): DECON/DSIM stay built-in
# (see gtaxllte-builtin.config), the panel driver is a module so a failed probe cannot
# affect boot. BACKLIGHT_CLASS_DEVICE gives GNOME /sys/class/backlight.
CONFIG_DRM_EXYNOS7_DECON=y
CONFIG_DRM_EXYNOS_DSI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SAMSUNG_GTAXLLTE_HX8279D=m

# Enabling BACKLIGHT_CLASS_DEVICE unhides defconfig's panel/backlight modules: keep them off (ballast).
# CONFIG_DRM_PANEL_BOE_TV101WUM_NL6 is not set
# CONFIG_DRM_PANEL_LVDS is not set
# CONFIG_DRM_PANEL_HIMAX_HX8279 is not set
# CONFIG_DRM_PANEL_HIMAX_HX83112A is not set
# CONFIG_DRM_PANEL_HIMAX_HX83112B is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E_CORE is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E_SPI is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9882T is not set
# CONFIG_DRM_PANEL_KHADAS_TS050 is not set
# CONFIG_DRM_PANEL_MANTIX_MLAF057WE51 is not set
# CONFIG_DRM_PANEL_NOVATEK_NT36672A is not set
# CONFIG_DRM_PANEL_NOVATEK_NT36672E is not set
# CONFIG_DRM_PANEL_NOVATEK_NT37801 is not set
# CONFIG_DRM_PANEL_RAYDIUM_RM67191 is not set
# CONFIG_DRM_PANEL_RAYDIUM_RM692E5 is not set
# CONFIG_DRM_PANEL_RENESAS_R63419 is not set
# CONFIG_DRM_PANEL_SAMSUNG_ATNA33XC20 is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7703 is not set
# CONFIG_DRM_PANEL_STARTEK_KD070FHFID015 is not set
# CONFIG_DRM_PANEL_EDP is not set
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_DRM_PANEL_SUMMIT is not set
# CONFIG_DRM_PANEL_VISIONOX_VTDR6130 is not set
# CONFIG_BACKLIGHT_SY7758 is not set
# CONFIG_BACKLIGHT_PWM is not set
# CONFIG_BACKLIGHT_QCOM_WLED is not set
# CONFIG_BACKLIGHT_LP855X is not set
# CONFIG_BACKLIGHT_GPIO is not set

# Sensors (standard IIO): LIS2HH12 accelerometer + CM3323 light sensor on
# i2c7, for iio-sensor-proxy. Modules.
CONFIG_IIO=y
# Buffer + trigger: the DRDY interrupt (gpa0-7) feeds a triggered buffer.
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGER=y
CONFIG_IIO_TRIGGERED_BUFFER=m
CONFIG_IIO_ST_ACCEL_3AXIS=m
CONFIG_IIO_ST_ACCEL_I2C_3AXIS=m
CONFIG_CM3323=m
# Defconfig default-sibling of the I2C part, no SPI sensors here.
# CONFIG_IIO_ST_ACCEL_SPI_3AXIS is not set

# Bluetooth: QCA9377 BT part on UART (serial1, hci_uart + hci_qca serdev). Standard
# BlueZ interfaces (HCI sockets, RFCOMM, BNEP, HIDP; BT_LE for BLE HID). Modules;
# hci_qca needs rfkill (built in) and the serdev bus (SERIAL_DEV_BUS=y).
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# Enabling BT_HCIUART unhides other vendors' drivers from defconfig: keep them off (ballast).
# CONFIG_BT_HCIBTUSB is not set
# CONFIG_BT_HCIBTUSB_MTK is not set
# CONFIG_BT_HCIUART_LL is not set
# CONFIG_BT_HCIUART_BCM is not set
# CONFIG_BT_HCIUART_MRVL is not set
# CONFIG_BT_MRVL is not set
# CONFIG_BT_MRVL_SDIO is not set
# CONFIG_BT_QCOMSMD is not set
# CONFIG_BT_NXPUART is not set

# cpuidle: PSCI C2 (core power-down); needs the exynos-pmu 7870 CPU PM notifier.
# Also makes s2idle freeze timekeeping (no journald/udevd watchdog restarts).
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
