# Reference: <https://postmarketos.org/devicepkg>
maintainer="Istvan Lovas <avataristvan@googlemail.com>"
pkgname=device-samsung-gtaxllte
pkgdesc="Samsung Galaxy Tab A 10.1 (2016) LTE"
pkgver=5
pkgrel=3
url="https://github.com/avataristvan/sm-t585-mainline"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-utils
	bluez
	linux-firmware-ath10k
	linux-firmware-qca
	linux-samsung-gtaxllte
	postmarketos-base
	systemd-boot
	wireless-regdb
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	kernel-cmdline.conf
	61-gtaxllte-keys.hwdb
	61-gtaxllte-battery.rules
	device-samsung-gtaxllte.post-install
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/61-gtaxllte-keys.hwdb \
		"$pkgdir"/usr/lib/udev/hwdb.d/61-gtaxllte-keys.hwdb
	install -Dm644 "$srcdir"/61-gtaxllte-battery.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-gtaxllte-battery.rules
}

