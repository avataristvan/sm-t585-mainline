CONFIG_ENV_SOURCE_FILE="gtaxllte"
# eMMC: the driver offers HS200/HS400 with generic tuning; downstream needs a
# board delay line (ddr200-delay-line 0x75) for HS400. U-Boot then read the GPT
# only sometimes ("unknown partition table type", 2026-10-26). Stay at DDR52.
# CONFIG_MMC_HS400_SUPPORT is not set
# CONFIG_MMC_HS400_ES_SUPPORT is not set
# CONFIG_MMC_HS200_SUPPORT is not set
